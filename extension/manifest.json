{
  "manifest_version": 3,
  "name": "VCU Browser Bridge",
  "version": "0.1.0",
  "description": "Versatile Computer Use — Agent Window bridge for Chrome/Edge. Does not move the OS cursor.",
  "permissions": ["tabs", "windows", "scripting", "storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "VCU",
    "default_popup": "popup.html"
  },
  "icons": {}
}
