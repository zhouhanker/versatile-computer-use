{
  "manifest_version": 3,
  "name": "VCU Browser Bridge",
  "version": "0.2.8",
  "description": "Versatile Computer Use — Agent Window bridge for Chrome/Edge. Does not move the OS cursor.",
  "permissions": [
    "tabs",
    "tabGroups",
    "windows",
    "scripting",
    "storage",
    "activeTab",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "VCU",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
